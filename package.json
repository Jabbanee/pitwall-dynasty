{
  "name": "pitwall-dynasty",
  "productName": "Pitwall Dynasty",
  "version": "0.1.0",
  "description": "Multiplayer-first motorsport management game with deterministic shared-broadcast races.",
  "author": {
    "name": "BaneWorks",
    "email": "noreply@baneworks.local"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "server": "tsx src/server/server.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "desktop:dev": "node scripts/desktop-dev.cjs",
    "desktop:build": "tsc --noEmit && vite build && node scripts/desktop-build.cjs",
    "desktop:package": "node scripts/desktop-package.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "three": "^0.185.1",
    "ws": "^8.21.3"
  }
}
