; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pitwall Dynasty"
config/description="Multiplayer-first motorsport team-management game with deterministic shared-broadcast races."
config/version="0.1.0"
run/main_scene="res://scenes/app/main.tscn"
config/features=PackedStringArray("4.7.2", "Forward+")
boot_splash/bg_color=Color(0.0509804, 0.0509804, 0.0705882, 1)
config/icon="res://assets/icons/app_icon.png"

[autoload]

AppState="*res://autoload/app_state.gd"
GameRouter="*res://autoload/game_router.gd"
SettingsService="*res://autoload/settings_service.gd"
ContentRegistry="*res://autoload/content_registry.gd"
NetworkSession="*res://autoload/network_session.gd"
SaveService="*res://autoload/save_service.gd"
VisualQA="*res://autoload/visual_qa.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"

